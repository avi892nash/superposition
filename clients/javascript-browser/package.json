{
  "name": "superposition_browser_client",
  "version": "0.1.0",
  "module": "./index.js",
  "files": ["dist"],
  "scripts": {
    "compile": "tsc -p tsconfig.json --noEmit",
    "build:bundle:esm": "esbuild src/index.ts --bundle --outfile=index.esm.js --format=esm",
    "build:bundle:cjs": "esbuild src/index.ts --bundle --outfile=index.js --format=cjs",
    "build": "npm run clean && npm run compile && npm run build:bundle:esm && npm run build:bundle:cjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "json-logic-js": "^2.0.2"
  },
  "devDependencies": {
    "@types/json-logic-js": "^2.0.1",
    "esbuild": "^0.19.0",
    "typescript": "^4.9.5"
  }
}